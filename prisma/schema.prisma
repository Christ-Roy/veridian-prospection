// Prisma schema — Prospection Dashboard (SIREN-centric SaaS)
// 2026-04-05: Radical refactor. `results`, `email_verification`, `phone_verification`,
// `pj_leads`, `ovh_monthly_destinations` are NO LONGER in the Prisma schema.
// They still exist in DB as legacy tables (filet de sécurité) but are not used.
//
// The source of truth is now `entreprises` (996K SIREN from open-data-hub v3.8).
// All metier tables (outreach, call_log, followups, claude_activity, outreach_emails,
// lead_segments) now reference `siren` instead of `domain`.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// ENTREPRISES — SIREN-centric master table (source: open-data-hub v3.8)
// ============================================================================
//
// Convention for dashboard queries:
//   - Always filter `is_registrar = false`
//   - Always filter `NOT COALESCE(ca_suspect, false)` (activates composite indexes)
//   - Use `best_phone_e164` (not `best_phone`)
//   - Sort by `prospect_score DESC` (0-100)

// ============================================================================
// OPERATIONAL TABLES — Referenced by SIREN
// ============================================================================

// ============================================================================
// WORKSPACES — Sous-découpage d'un tenant pour cloisonner les commerciaux
// ============================================================================

model Workspace {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId      String    @map("tenant_id") @db.Uuid
  name          String
  slug          String
  // LEGACY — cap de plan jamais branché (1 ref read-only dans admin/kpi).
  // Conservé tel quel (le drop = migration destructive). Le quota refill
  // vit désormais dans leadsCredited/leadsConsumed ci-dessous.
  leadsLimit    Int?      @map("leads_limit")
  // Quota refill leads (ticket refill 1/3, CONTRAT-BILLING §8.4).
  //   solde = leadsCredited - leadsConsumed
  // - leadsCredited : cumul des crédits (achats Stripe one-shot + welcome).
  //   Incrémenté SEULEMENT par POST /api/tenants/{id}/credit-leads.
  // - leadsConsumed : cumul des leads consommés (1 fiche entreprise débloquée).
  //   Incrémenté par la consultation d'une fiche, idempotent par (ws, siren).
  leadsCredited Int       @default(0) @map("leads_credited")
  leadsConsumed Int       @default(0) @map("leads_consumed")
  createdBy     String?   @map("created_by") @db.Uuid
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  // SaaS standard — soft delete (P1.1). Purge définitive cron 30j (P1.6).
  deletedAt     DateTime? @map("deleted_at") @db.Timestamptz

  // Contrat Hub §5.6 + §6.2 — Bearer api_key tenant pour generateMagicLink.
  // 1 api_key = 1 workspace (scoping strict). Hash sha256 hex (64 chars), la
  // clé en clair n'est jamais persistée — retournée au Hub une seule fois au
  // provision puis stockée côté Hub dans hub_app.tenants.prospectionApiKey.
  apiKeyHash      String?   @unique @map("api_key_hash")
  apiKeyCreatedAt DateTime? @map("api_key_created_at") @db.Timestamptz

  // Préférences workspace — switch mode agence + onboarding (ticket
  // 2026-05-22 switch-mode-agence-et-onboarding).
  //
  // displayMode : "generic" (DÉFAUT, tri par CA/effectif/prospect_score)
  //             | "agency"  (tri par dette technique — niche agence web)
  // Pas un filtre : les mêmes leads visibles dans les 2 modes, seul l'ORDER BY change.
  //
  // defaultGeoFilters / defaultSectorFilters : choix de l'onboarding,
  // pré-remplissent les sidebars existantes — modifiables à tout moment.
  // JSON arbitraire {departements: ["69", "42"], secteurs: ["BTP", "..."]}
  //
  // onboardingCompletedAt : NULL = onboarding pas fait, l'overlay
  // /components/layout/onboarding.tsx s'affiche au login. Datetime = fait.
  displayMode           String    @default("generic") @map("display_mode")
  defaultGeoFilters     Json?     @map("default_geo_filters")
  defaultSectorFilters  Json?     @map("default_sector_filters")
  onboardingCompletedAt DateTime? @map("onboarding_completed_at") @db.Timestamptz

  // Mail v2 — provider d'envoi (migration 0025).
  //
  // 'none'             : default — SMTP BYO via TenantMailConfig ou pas d'envoi (v1)
  // 'gmail-via-hub'    : route /api/mail/send envoie via Hub Mail Gateway (Gmail OAuth user)
  // 'microsoft-via-hub': réservé v2 (Microsoft Mail Sender pas livré v1)
  //
  // L'OAuth Gmail lui-même est stocké côté Hub sur user.hubUserId — Prosp
  // ne persiste que le state "ce workspace utilise cette voie d'envoi".
  // gmail_connected_at : timestamp du dernier toggle "connecté" pour audit
  // (peut être null si le user a déconnecté). gmail_quota_per_day : quota
  // local pour rate-limit côté Prosp avant d'envoyer (Hub fait son propre
  // rate-limit, on cap côté client pour éviter le 429 inutile).
  mailProvider       String    @default("none") @map("mail_provider")
  gmailConnectedAt   DateTime? @map("gmail_connected_at") @db.Timestamptz
  gmailQuotaPerDay   Int       @default(250) @map("gmail_quota_per_day")

  members          WorkspaceMember[]

  @@unique([tenantId, slug])
  @@index([tenantId])
  @@index([tenantId, deletedAt])
  @@map("workspaces")
}

// ============================================================================
// REFILL LEADS — quota + historique (ticket refill 1/3, CONTRAT-BILLING §8.4)
// ============================================================================

model WorkspaceMember {
  workspaceId     String    @map("workspace_id") @db.Uuid
  userId          String    @map("user_id") @db.Uuid
  // Roles: "owner" | "admin" | "member" | "viewer" (voir src/lib/auth/roles.ts)
  // Legacy values "admin" / "member" existent déjà, compat OK.
  role            String    @default("member")
  visibilityScope String    @default("all") @map("visibility_scope") // "all" | "own"
  joinedAt        DateTime  @default(now()) @map("joined_at") @db.Timestamptz
  // SaaS standard — soft delete (P1.1)
  deletedAt       DateTime? @map("deleted_at") @db.Timestamptz
  // CONTRAT-HUB §5.21 — freeze cross-app. Si non NULL, le user est en mode
  // dégradé paywall sur ce workspace (obfuscation sensitive fields + 402 sur
  // écritures). Levé via /api/tenants/{id}/unfreeze-members.
  frozenAt        DateTime? @map("frozen_at") @db.Timestamptz

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@id([workspaceId, userId])
  @@index([userId])
  @@index([workspaceId, deletedAt])
  @@index([frozenAt])
  @@map("workspace_members")
}

// ============================================================================
// AUDIT LOG — SaaS standard (docs/saas-standards.md §7)
// ============================================================================
// Table immutable, read-only, rétention minimum 365 jours.
// Pas de migration encore jouée — P1.7 main agent only. Le helper src/lib/audit.ts
// tolère l'absence de la table (warn + skip) en attendant.

model AuditLog {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId   String?  @map("tenant_id") @db.Uuid
  actorId    String?  @map("actor_id") @db.Uuid
  actorType  String   @map("actor_type") // 'user' | 'hub' | 'stripe' | 'system'
  action     String // 'workspace.deleted', 'plan.changed', ...
  targetType String?  @map("target_type")
  targetId   String?  @map("target_id")
  metadata   Json?
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@index([tenantId, createdAt(sort: Desc)])
  @@index([actorId])
  @@index([action])
  @@map("audit_log")
}

/// Client-side JS errors captured by ClientErrorBoundary (window.onerror +
/// unhandledrejection). Persisted to make intermittent prod bugs queryable.
/// Cf. todo/2026-05-23-persist-client-errors-db.md.
///
/// Dedupe model : one row per (dedupeKey, occurredHour). `dedupeKey` = sha1
/// of (message + filename + lineno) truncated to 16 chars. `occurredHour`
/// = truncated to the hour. The combined unique index lets `/api/errors`
/// upsert + increment `count` instead of growing one row per occurrence,
/// keeping the table bounded even in a crash loop.
///
/// PII guardrails (enforced by /api/errors route, NOT the schema) :
///   - message truncated to 1000 chars
///   - stack truncated to 2000 chars
///   - userAgent truncated to 200 chars
model ClientError {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String?  @map("tenant_id") @db.Uuid
  workspaceId  String?  @map("workspace_id") @db.Uuid
  userId       String?  @map("user_id") @db.Uuid
  message      String   @db.Text
  stack        String?  @db.Text
  url          String?  @db.Text
  userAgent    String?  @map("user_agent")
  dedupeKey    String   @map("dedupe_key")
  occurredHour DateTime @map("occurred_hour") @db.Timestamptz
  occurredAt   DateTime @default(now()) @map("occurred_at") @db.Timestamptz
  lastSeenAt   DateTime @default(now()) @map("last_seen_at") @db.Timestamptz
  count        Int      @default(1)

  @@unique([dedupeKey, occurredHour], map: "client_errors_dedupe_hour_key")
  @@index([occurredAt(sort: Desc)])
  @@index([tenantId, occurredAt(sort: Desc)])
  @@map("client_errors")
}

// Invitations locales retirées le 09/11 (une invitation crée un utilisateur : c'est le Hub).
// Table invitations dumpée au froid puis supprimée (migration 0036).

// ============================================================================
// PUSH SUBSCRIPTIONS — Web Push API (PWA notifications)
// ============================================================================
// Stores browser push endpoints for sending notifications (rappels pipeline,
// demos, nouveaux leads). VAPID keys shared with Analytics app.
// Cleanup: expired endpoints (410 Gone) are deleted on send failure.

model PushSubscription {
  id        Int      @id @default(autoincrement())
  tenantId  String   @map("tenant_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  // Device metadata (for debugging / segmentation)
  userAgent String? @map("user_agent") @db.Text
  platform  String? // "ios" | "android" | "desktop"

  @@index([tenantId])
  @@index([userId])
  @@map("push_subscriptions")
}

// ============================================================================
// APPOINTMENTS — RDV dedies par tenant (source de verite calendrier + push)
// ============================================================================
// Ajoute 2026-04-15. Remplace progressivement outreach.deadline pour le
// tracking des RDV. Le cron check-reminders scanne les deux pendant la
// transition. Voir scripts/2026-04-15_appointments-and-prefs.sql.

// ============================================================================
// NOTIFICATION PREFERENCES — Per-user toggles pour les push
// ============================================================================

// ============================================================================
// AUTH.JS v5 — Migration Supabase Auth → Auth.js (2026-05-06)
// Tables locales pour rendre Prospection autonome (plus de dépendance Supabase).
// Pattern copié depuis hub/prisma/schema.prisma (P1.4 hub-auth-builder).
// UUIDs préservés depuis auth.users.id Supabase (compat WorkspaceMember.userId).
// ============================================================================

model User {
  // UUID préservé depuis auth.users.id Supabase pour compat FK existantes.
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name          String?
  email         String    @unique
  emailVerified DateTime? @map("email_verified") @db.Timestamptz
  image         String?

  // 2FA email opt-in (cohérent avec Hub)
  mfaEnabled Boolean @default(false) @map("mfa_enabled")

  // Administrateur Atlas (équipe Veridian) : accorde ou retire l'accès avancé des espaces.
  atlasAdmin Boolean @default(false) @map("atlas_admin")

  // Legacy bridge — pour audit / debug. À terme on peut retirer cette colonne
  // (les UUIDs sont identiques à auth.users.id donc redondant) mais on garde
  // pendant la phase de migration pour traçabilité.
  supabaseUserId String? @unique @map("supabase_user_id") @db.Uuid

  // Identité Hub (CONTRAT-HUB v1.5 §3.7). Nullable + backfillé au premier
  // contact Hub (provision, attach-owner, attach-member). Source de vérité
  // humaine côté Hub, PK locale `id` reste inchangée.
  hubUserId String? @unique @map("hub_user_id") @db.Uuid

  // Sessions ouvertes avant cette date refusées (CONTRAT-HUB §3.8, revoke_sessions).
  sessionsValidAfter DateTime? @map("sessions_valid_after") @db.Timestamptz

  accounts Account[]
  sessions Session[]
  ssoLoginTokens SsoLoginToken[]
  sessionDelegations SessionDelegation[]
  iaFils IaFil[]
  adminsPlateforme AdminPlateforme[]

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  // Soft delete (saas-standards §1.6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz

  @@index([deletedAt])
  @@map("users")
}

// Jetons d'autologin du rebond Hub (CONTRAT-HUB §6bis.8.3). One-shot, 15 min,
// hachés sha256, liés au user pour couvrir les membres invités.
model SsoLoginToken {
  tokenHash String    @id @map("token_hash")
  userId    String    @map("user_id") @db.Uuid
  expiresAt DateTime  @map("expires_at") @db.Timestamptz
  usedAt    DateTime? @map("used_at") @db.Timestamptz
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz
  /// Poignée de délégation du Hub, chiffrée, jusqu'à l'ouverture de la session (src/lib/liaisons/poignee.ts).
  delegation String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sso_login_tokens")
}

/// Poignée de délégation du Hub (VER-246), chiffrée, liée à UNE session de navigateur. Elle meurt avec elle.
model SessionDelegation {
  sessionId   String   @map("session_id") @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  /// Tenant Hub auquel la poignée est liée : elle ne sert que dans l'espace relié à ce tenant.
  hubTenantId String   @map("hub_tenant_id") @db.Uuid
  poignee     String
  expireLe    DateTime @map("expire_le") @db.Timestamptz
  creeLe      DateTime @default(now()) @map("cree_le") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([sessionId, hubTenantId])
  @@index([userId])
  @@map("session_delegations")
}

model Account {
  id                String  @id @default(cuid())
  userId            String  @map("user_id") @db.Uuid
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String?
  access_token      String? // pour provider=credentials, contient le bcrypt hash
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id") @db.Uuid
  expires      DateTime @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime @db.Timestamptz

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ============================================================================
// TENANT — Migré depuis Supabase public.tenants
// Source de vérité de l'état SaaS d'un client (plan, status, integrations
// twenty/notifuse). Auparavant dans Supabase, désormais local à Prospection.
// ============================================================================

enum TenantStatus {
  pending
  active
  suspended
  deleted

  @@map("tenant_status")
}

model Tenant {
  id     String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  // user_id = owner (l'utilisateur qui a signé). FK vers User mais le UUID est
  // identique à l'ancien auth.users.id, donc préservé.
  userId String       @map("user_id") @db.Uuid
  name   String
  slug   String       @unique
  status TenantStatus @default(pending)

  // Identifiant du tenant côté Hub, reçu au provisionnement (hub_tenant_id). Sert à retenir le
  // claim tenant_id du jeton MCP (CONTRAT-MCP §2). Les ids locaux restent distincts de ceux du Hub.
  hubTenantId String? @unique @map("hub_tenant_id") @db.Uuid

  // Accès avancé Atlas (16/11, Robert) : requêtes SQL en lecture sur ODH et clés API. Accordé un par un
  // par un administrateur Atlas (users.atlas_admin), jamais par le plan.
  accesAvance Boolean @default(false) @map("acces_avance")

  // Intégrations Twenty CRM
  twentyWorkspaceId         String?   @map("twenty_workspace_id") @db.Uuid
  twentySubdomain           String?   @map("twenty_subdomain")
  twentyUserEmail           String?   @map("twenty_user_email")
  // twenty_api_key, twenty_user_password, twenty_login_token(_created_at) : secrets en clair que
  // rien ne lisait, vidés le 09/11 (dump au froid), colonnes supprimées par la migration suivante.

  // Autologin SSO Veridian (couche 1 — token one-shot Hub→Prospection).
  // Le token est généré par POST /api/tenants/provision (HMAC Hub), stocké
  // ici en clair (random 32 bytes hex, validité 24h, one-shot), et consommé
  // par GET /api/auth/token?t=<token> qui crée une session Auth.js locale.
  // Avant 2026-05-20, cette colonne était lue depuis Supabase tenants
  // legacy — migration vers DB locale Prosp pour virer la dépendance Supabase.
  prospectionLoginToken          String?   @map("prospection_login_token")
  prospectionLoginTokenCreatedAt DateTime? @map("prospection_login_token_created_at") @db.Timestamptz
  prospectionLoginTokenUsedAt    DateTime? @map("prospection_login_token_used_at") @db.Timestamptz

  // Intégrations Notifuse
  notifuseWorkspaceSlug    String?   @map("notifuse_workspace_slug")
  notifuseUserEmail        String?   @map("notifuse_user_email")
  notifuseInvitationSentAt DateTime? @map("notifuse_invitation_sent_at") @db.Timestamptz

  metadata Json?

  // Plan SaaS — source de vérité pour le pilotage Hub (contrat §5.2).
  // Valeurs possibles : freemium | pro | enterprise | starter |
  // lifetime_site_vitrine | lifetime_partner | internal.
  plan       String? @default("freemium")
  // Source de la dernière mise à jour de plan — bloque le downgrade Stripe
  // sur lifetime_* / internal (cf §3.3 immunité plan_source).
  // Valeurs : stripe | manual | lifetime_site_vitrine | lifetime_partner | internal.
  planSource String? @default("stripe") @map("plan_source")

  provisionedAt  DateTime? @map("provisioned_at") @db.Timestamptz
  lastActivityAt DateTime? @map("last_activity_at") @db.Timestamptz
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  // Lifecycle v1.1 — machine à états contrat §5.7.
  //
  // Transitions légales :
  //   active ⇄ suspended → soft_deleted → purge_eligible → purged (humain)
  //   soft_deleted → restore vers suspended
  //   soft_deleted + touch → repousse purge_eligible_at
  //
  // Colonnes :
  //   deletedAt        : NOW() au soft-delete, NULL au restore
  //   purgeEligibleAt  : NOW() + SOFT_DELETE_GRACE_DAYS (90j default)
  //   lastTouchedAt    : NOW() à chaque tenant.touched (throttle 24h)
  //   purgedAt         : NOW() au purge irréversible (audit GDPR)
  deletedAt       DateTime? @map("deleted_at") @db.Timestamptz
  purgeEligibleAt DateTime? @map("purge_eligible_at") @db.Timestamptz
  lastTouchedAt   DateTime? @map("last_touched_at") @db.Timestamptz
  purgedAt        DateTime? @map("purged_at") @db.Timestamptz

  planHistory PlanHistory[]

  @@index([userId])
  @@index([status])
  @@index([deletedAt])
  @@index([purgeEligibleAt])
  iaFils IaFil[]
  adminsPlateforme AdminPlateforme[]
  @@map("tenants")
}

/// Audit trail des changements de plan (contrat §5.2).
/// Rétention minimale : 50 dernières lignes par tenant.
///
/// `idempotencyKey` : clé de dédup du payload `update-plan` v2
/// (CONTRAT-BILLING.md §3.4.3). Index UNIQUE partiel — un replay du même
/// key viole la contrainte, le handler renvoie alors un 200 no-op. Nullable :
/// les lignes pré-v2 n'ont pas de clé.
model PlanHistory {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  plan           String
  planSource     String   @map("plan_source")
  previousPlan   String?  @map("previous_plan")
  reason         String?
  idempotencyKey String?  @unique @map("idempotency_key")
  changedAt      DateTime @default(now()) @map("changed_at") @db.Timestamptz

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, changedAt(sort: Desc)])
  @@map("veridian_plan_history")
}

/// Pattern transactional outbox — webhooks Prospection → Hub durables.
///
/// Cf ticket 2026-05-23-emit-webhook-events-niveau2-sync-followup-outbox.md
/// et migration 0023. Au lieu d'émettre fire-and-forget depuis chaque route
/// mutante (risque de perte si crash entre commit DB et fetch sortant), on
/// INSERT une row dans `webhook_outbox` dans la MÊME transaction Prisma. Un
/// worker cron (POST /api/cron/process-outbox) consomme ensuite les rows
/// avec retry exponentiel.
///
/// `status` (text + CHECK côté SQL, string ici pour rester additif) :
///   - `pending`       — enqueued, jamais essayé
///   - `sending`       — locké par un worker via SELECT FOR UPDATE
///   - `sent`          — Hub a répondu 200 (dédup côté Hub via idempotency_key)
///   - `failed_retry`  — fetch a échoué, en attente du prochain retry
///   - `dead`          — > MAX_ATTEMPTS échecs consécutifs, sortie de la file
///
/// `nextRetryAt` : backoff exponentiel (1s, 2s, 4s, 8s, …, cap 1h).
/// `idempotencyKey` : UUID injecté dans le payload Hub (header §7.1 v1.4),
/// UNIQUE côté outbox pour rejeter à l'INSERT un replay.
///
/// Pas de FK vers `tenants` exprès : un event peut survivre au purge du
/// tenant (cas legit : `tenant.purged` lui-même), et inversement le worker
/// doit pouvoir nettoyer des events orphelins sans cascade.
model WebhookOutbox {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eventType      String    @map("event_type") @db.VarChar(64)
  tenantId       String    @map("tenant_id") @db.Uuid
  payload        Json
  idempotencyKey String    @unique @map("idempotency_key") @db.Uuid
  status         String    @default("pending") @db.VarChar(16)
  attempts       Int       @default(0)
  nextRetryAt    DateTime  @default(now()) @map("next_retry_at") @db.Timestamptz
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz
  sentAt         DateTime? @map("sent_at") @db.Timestamptz
  lastError      String?   @map("last_error")

  @@index([status, nextRetryAt])
  @@index([tenantId, createdAt(sort: Desc)])
  @@index([status])
  @@map("webhook_outbox")
}

// ============================================================================
// Atlas (refonte 09/11, docs/PLAN-ATLAS.md) : dossiers, segments et scorings versionnés.
// Les données marché sont lues dans ClickHouse ODH ; ici, seulement ce que l'utilisateur crée.
// ============================================================================

model AtlasDossier {
  id        String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String          @map("tenant_id") @db.Uuid
  parentId  String?         @map("parent_id") @db.Uuid
  nom       String
  segments  AtlasSegment[]
  createdAt DateTime        @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt DateTime?       @map("deleted_at") @db.Timestamptz

  @@index([tenantId, deletedAt])
  @@map("atlas_dossiers")
}

model AtlasSegment {
  id        String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String                @map("tenant_id") @db.Uuid
  dossierId String?               @map("dossier_id") @db.Uuid
  dossier   AtlasDossier?         @relation(fields: [dossierId], references: [id])
  /// Segment parent : ses conditions s'ajoutent à celles de l'enfant.
  parentId  String?               @map("parent_id") @db.Uuid
  nom       String
  /// Colonnes affichées (ids du catalogue src/atlas/champs.ts).
  colonnes  Json                  @default("[]")
  versions  AtlasSegmentVersion[]
  scorings  AtlasScoringVersion[]
  createdAt DateTime              @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime              @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt DateTime?             @map("deleted_at") @db.Timestamptz

  @@index([tenantId, deletedAt])
  @@map("atlas_segments")
}

model AtlasSegmentVersion {
  id        String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  segmentId String       @map("segment_id") @db.Uuid
  segment   AtlasSegment @relation(fields: [segmentId], references: [id], onDelete: Cascade)
  numero    Int
  /// Filtre validé (src/atlas/filtres.ts).
  filtre    Json
  /// Utilisateur local, ou client IA via le MCP.
  auteur    String
  via       String       @default("interface")
  note      String?
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz

  @@unique([segmentId, numero])
  @@map("atlas_segment_versions")
}

model AtlasScoringVersion {
  id        String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  segmentId String       @map("segment_id") @db.Uuid
  segment   AtlasSegment @relation(fields: [segmentId], references: [id], onDelete: Cascade)
  numero    Int
  /// Critères pondérés : conditions du catalogue avec un poids (src/atlas/scoring.ts).
  criteres  Json
  auteur    String
  via       String       @default("interface")
  note      String?
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz

  @@unique([segmentId, numero])
  @@map("atlas_scoring_versions")
}

/// Dossier de travail Atlas : entreprises épinglées par un humain ou une IA, par espace.
model AtlasEpingle {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  siren     String
  nom       String
  note      String?
  auteur    String
  via       String   @default("interface")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@unique([tenantId, siren])
  @@map("atlas_epingles")
}

/// Clients de l'espace, importés par SIREN ou SIRET (src/atlas/clients.ts). Aucune coordonnée : le numéro seul.
model AtlasClient {
  tenantId  String   @map("tenant_id") @db.Uuid
  siren     String
  ajoutePar String   @map("ajoute_par")
  creeLe    DateTime @default(now()) @map("cree_le") @db.Timestamptz

  @@id([tenantId, siren])
  @@map("atlas_clients")
}

/// Vente d'un espace, rattachée au SIREN du client (src/atlas/ventes.ts). `reference` : « ref:… » donnée, ou « auto:… » calculée.
model AtlasVente {
  tenantId  String    @map("tenant_id") @db.Uuid
  reference String
  siren     String
  montant   Decimal   @db.Decimal(14, 2)
  date      DateTime? @db.Date
  ajoutePar String    @map("ajoute_par")
  creeLe    DateTime  @default(now()) @map("cree_le") @db.Timestamptz

  @@id([tenantId, reference])
  @@index([tenantId, siren])
  @@map("atlas_ventes")
}

/// Rapport PDF d'un marché : le texte et son auteur ; les chiffres se relisent à chaque ouverture (src/atlas/rapport.ts).
model AtlasRapport {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  segmentId String   @map("segment_id") @db.Uuid
  titre     String
  texte     String
  auteur    String
  creeLe    DateTime @default(now()) @map("cree_le") @db.Timestamptz

  @@index([tenantId, creeLe])
  @@map("atlas_rapports")
}

/// IA qui ont appelé Prospection par la porte MCP du Hub (une ligne par utilisateur et client OAuth).
model AtlasPresenceIa {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  clientId     String   @map("client_id")
  clientNom    String?  @map("client_nom")
  premierAppel DateTime @default(now()) @map("premier_appel") @db.Timestamptz
  dernierAppel DateTime @default(now()) @map("dernier_appel") @db.Timestamptz

  @@unique([userId, clientId])
  @@map("atlas_presence_ia")
}

/// Compteur durable par clé et par fenêtre (src/lib/compteurs.ts) : quota de vérification, limite de connexion.
model Compteur {
  cle     String
  fenetre DateTime @db.Timestamptz
  n       Int

  @@id([cle, fenetre])
  @@map("compteurs")
}

/// Extraction paginée d'un segment par le MCP (VER-242) : la liste ordonnée des SIREN est figée à la première
/// page. Aucune coordonnée n'est copiée : chaque page relit ODH, et retire ce qui n'est plus envoyable.
model AtlasExtraction {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  segmentId      String   @map("segment_id") @db.Uuid
  segmentVersion Int      @map("segment_version")
  /// SHA-256 du filtre effectif (parents compris) et du scoring : une autre définition, une autre extraction.
  empreinte      String
  userId         String   @map("user_id") @db.Uuid
  client         String?
  versionOdh     String   @map("version_odh")
  sirens         String[]
  /// Entreprises envoyables du segment, au-delà de la liste figée quand elle est plafonnée.
  totalSegment   Int      @map("total_segment")
  creeLe         DateTime @default(now()) @map("cree_le") @db.Timestamptz
  expireLe       DateTime @map("expire_le") @db.Timestamptz

  @@index([tenantId, segmentId, creeLe])
  @@map("atlas_extractions")
}

/// Journal des exports (écran et MCP) : qui, quand, quel segment et quelle version, combien de lignes.
/// Pour le MCP, une ligne par page : c'est aussi le compteur du quota quotidien de l'espace.
model AtlasExport {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  client         String?
  /// « ecran » (Excel, CSV), « mcp » (extraire_segment) ou « liaison » (envoi vers le CRM ou Mail).
  canal          String
  format         String
  /// Nuls pour l'envoi d'une seule fiche.
  segmentId      String?  @map("segment_id") @db.Uuid
  segmentVersion Int?     @map("segment_version")
  extractionId   String?  @map("extraction_id") @db.Uuid
  debut          Int?
  lignes         Int
  creeLe         DateTime @default(now()) @map("cree_le") @db.Timestamptz

  @@unique([extractionId, debut])
  @@index([tenantId, canal, creeLe])
  @@map("atlas_exports")
}

/// Envoi vers une autre app Veridian (VER-246) : une ligne par geste et par étape. Un geste rejoué rend son premier
/// résultat. Le résultat ne contient ni email ni téléphone.
model AtlasEnvoi {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  geste     String   @db.Uuid
  etape     String
  cible     String
  reference String
  /// « en_cours », « fait » ou « echec ».
  etat      String
  /// Compté au quota et au journal des exports.
  tracee    Boolean  @default(false)
  resultat  Json?
  creeLe    DateTime @default(now()) @map("cree_le") @db.Timestamptz
  majLe     DateTime @default(now()) @map("maj_le") @db.Timestamptz

  @@unique([tenantId, geste, etape])
  @@index([tenantId, cible, creeLe])
  @@map("atlas_envois")
}

/// Clé API Atlas d'un espace à accès avancé : seule l'empreinte SHA-256 est gardée, la clé n'est montrée
/// qu'une fois. Elle agit au nom de son créateur, dans son espace, avec les droits de son créateur.
model AtlasCleApi {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId            String    @map("tenant_id") @db.Uuid
  userId              String    @map("user_id") @db.Uuid
  nom                 String
  prefixe             String
  empreinte           String    @unique
  creeLe              DateTime  @default(now()) @map("cree_le") @db.Timestamptz
  derniereUtilisation DateTime? @map("derniere_utilisation") @db.Timestamptz
  revoqueeLe          DateTime? @map("revoquee_le") @db.Timestamptz

  @@index([tenantId])
  @@map("atlas_cles_api")
}

/// Fil de l'assistant « Mon IA » (VER-203, CONTRAT-HUB §5.24) : rangé ici, lu et écrit par le Hub seul. Un fil = une session du Hub,
/// pour UN membre d'UN espace ; il disparaît avec l'espace (purge) et avec le membre (retrait).
model IaFil {
  sessionId   String   @id @map("session_id") @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  /// UIMessage[] du SDK `ai`, tel quel ; jamais interprété ici.
  messages    Json
  creeLe      DateTime @default(now()) @map("cree_le") @db.Timestamptz
  majLe       DateTime @updatedAt @map("maj_le") @db.Timestamptz

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId, userId])
  @@map("ia_fils")
}

/// Administrateurs de plateforme désignés par le Hub dans l'espace d'un client (CONTRAT-HUB §5.23, VER-263). Une désignation
/// dont la personne ne tient plus le rôle admin EST un retrait par le client : aucun chemin ne la remet admin, sauf
/// `reinstate: true` (geste humain). src/lib/hub/admins-plateforme.ts.
model AdminPlateforme {
  tenantId String   @map("tenant_id") @db.Uuid
  userId   String   @map("user_id") @db.Uuid
  acteur   String
  raison   String?
  accordeLe DateTime @default(now()) @map("accorde_le") @db.Timestamptz

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([tenantId, userId])
  @@map("admins_plateforme")
}
